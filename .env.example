# Configuration Amireflow Study OS — Projet Supabase rzjjcqmsepxtpmqwzwmf (eu-west-3)

# Backend (FastAPI)
APP_ENV=local
# Secret JWT HS256 >= 32 octets aléatoires en production (obligatoire)
APP_SECRET_KEY=change-me-in-local-env
# Clé de chiffrement AES-256-GCM des clés API IA (32 octets encodés base64 ou 64 caractères hex, ex. "k1:<64_hex>")
# Requis dès qu'un utilisateur enregistre une clé API fournisseur personnalisée
AI_KEY_ENCRYPTION_KEY=
# Anciennes clés pour rotation sans rupture (format "id1:secret1,id2:secret2")
AI_KEY_ENCRYPTION_FALLBACK_KEYS=
# Par défaut en local : sqlite:///./amireflow_local.db
# Sur Render (egress IPv4 uniquement) : utilisez le Session Pooler (port 5432) ou Transaction Pooler (port 6543) Supabase
# ex. postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Ou une base PostgreSQL Render managée.
DATABASE_URL=sqlite:///./amireflow_local.db
ALLOW_LOCAL_DEV_AUTH=true
ALLOW_INSECURE_LOCAL_AI_URL=false
AUTH_JWKS_URL=https://rzjjcqmsepxtpmqwzwmf.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://rzjjcqmsepxtpmqwzwmf.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
# En production cross-origin (*.onrender.com), utilisez "none" (cookies HttpOnly Secure requis)
AUTH_COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:5173
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=local-coach-v1

# Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://rzjjcqmsepxtpmqwzwmf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_hGTCEH3pCjQcY_M-t3snyA_FvUSCBac
